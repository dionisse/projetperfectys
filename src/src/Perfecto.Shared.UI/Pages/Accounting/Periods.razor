@page "/comptabilite/periodes"
@inject IAccountingService AccountingService

<PageTitle>Périodes comptables — PERFECTO</PageTitle>

<section class="module-hero compact-hero">
    <div><span class="eyebrow">Contrôles de l’exercice</span><h1>Périodes comptables</h1><p>Ouvrir ou clôturer la saisie mois par mois pour l’exercice 2026.</p></div>
    <a class="button button-secondary" href="/comptabilite">Retour au module</a>
</section>

@if (!string.IsNullOrEmpty(_message)) { <div class="form-message success wide-message">@_message</div> }

<section class="period-grid">
    @foreach (var period in _periods)
    {
        <article class="panel period-card @(period.IsClosed ? "closed" : "open")">
            <div><span class="period-number">@period.Month.ToString("00")</span><h2>@UpperFirst(period.Label)</h2></div>
            <span class="status-badge @(period.IsClosed ? "draft" : "success")">@(period.IsClosed ? "Clôturée" : "Ouverte")</span>
            <button class="button button-secondary full-width" type="button" @onclick="() => ToggleAsync(period)">@(period.IsClosed ? "Rouvrir la période" : "Clôturer la période")</button>
        </article>
    }
</section>

<section class="panel info-panel"><strong>Protection active</strong><p>Une période clôturée refuse toute nouvelle pièce et toute validation d’un brouillon daté dans ce mois. La réouverture reste disponible dans ce prototype pour faciliter les essais.</p></section>

@code {
    private IReadOnlyList<AccountingPeriodDto> _periods = [];
    private string _message = string.Empty;
    protected override async Task OnInitializedAsync() => _periods = await AccountingService.GetPeriodsAsync();
    private async Task ToggleAsync(AccountingPeriodDto period) { var updated = await AccountingService.SetPeriodClosedAsync(period.Month, !period.IsClosed); _periods = _periods.Select(item => item.Month == updated.Month ? updated : item).ToList(); _message = $"La période {updated.Label} est maintenant {(updated.IsClosed ? "clôturée" : "ouverte")}."; }
    private static string UpperFirst(string value) => value.Length == 0 ? value : char.ToUpperInvariant(value[0]) + value[1..];
}
