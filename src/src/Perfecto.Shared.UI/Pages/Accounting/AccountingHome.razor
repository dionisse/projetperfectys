@page "/comptabilite"
@inject IAccountingService AccountingService

<PageTitle>Comptabilité générale — PERFECTO</PageTitle>

@if (_snapshot is null)
{
    <section class="loading-panel"><div class="loading-bar"></div><p>Chargement de la comptabilité…</p></section>
}
else
{
    <section class="module-hero accounting-hero">
        <div>
            <span class="eyebrow">CG · SYSCOHADA révisé</span>
            <h1>Comptabilité générale</h1>
            <p>Exercice 2026 ouvert · Société Démo · Devise XOF</p>
        </div>
        <div class="accounting-actions">
            <span class="storage-chip">@_snapshot.StorageMode</span>
            <a class="button button-primary" href="/comptabilite/pieces/nouvelle">Nouvelle pièce</a>
        </div>
    </section>

    <section class="kpi-grid accounting-kpis">
        <KpiCard Label="Comptes actifs" Value="@_snapshot.AccountCount.ToString()" Hint="Plan SYSCOHADA initial" Icon="≡" Tone="blue" />
        <KpiCard Label="Journaux" Value="@_snapshot.JournalCount.ToString()" Hint="Achats, ventes, banque…" Icon="J" Tone="violet" />
        <KpiCard Label="Pièces validées" Value="@_snapshot.PostedEntryCount.ToString()" Hint="Écritures immuables" Icon="✓" Tone="green" />
        <KpiCard Label="Brouillons" Value="@_snapshot.DraftEntryCount.ToString()" Hint="À vérifier" Icon="✎" Tone="amber" />
    </section>

    <section class="accounting-nav-grid">
        <a class="accounting-nav-card" href="/comptabilite/plan">
            <span class="nav-card-icon">01</span><div><h2>Plan comptable</h2><p>Consulter et enrichir les comptes généraux.</p></div><strong>→</strong>
        </a>
        <a class="accounting-nav-card" href="/comptabilite/journaux">
            <span class="nav-card-icon">02</span><div><h2>Journaux</h2><p>Achats, ventes, trésorerie et opérations diverses.</p></div><strong>→</strong>
        </a>
        <a class="accounting-nav-card" href="/comptabilite/pieces">
            <span class="nav-card-icon">03</span><div><h2>Pièces comptables</h2><p>Saisir, contrôler et consulter les écritures.</p></div><strong>→</strong>
        </a>
        <a class="accounting-nav-card" href="/comptabilite/balance">
            <span class="nav-card-icon">04</span><div><h2>Balance générale</h2><p>Vérifier les mouvements et les soldes des comptes.</p></div><strong>→</strong>
        </a>
        <a class="accounting-nav-card" href="/comptabilite/etats/journal">
            <span class="nav-card-icon">05</span><div><h2>Journal des écritures</h2><p>Parcourir les mouvements validés dans l’ordre chronologique.</p></div><strong>→</strong>
        </a>
        <a class="accounting-nav-card" href="/comptabilite/etats/grand-livre">
            <span class="nav-card-icon">06</span><div><h2>Grand livre</h2><p>Suivre le détail et le solde cumulé de chaque compte.</p></div><strong>→</strong>
        </a>
        <a class="accounting-nav-card" href="/comptabilite/periodes">
            <span class="nav-card-icon">07</span><div><h2>Périodes comptables</h2><p>Contrôler l’ouverture mensuelle de la saisie.</p></div><strong>→</strong>
        </a>
    </section>

    <div class="accounting-home-grid">
        <section class="panel data-panel">
            <div class="panel-heading">
                <div><span class="eyebrow">Dernières opérations</span><h2>Pièces récentes</h2></div>
                <a class="text-link" href="/comptabilite/pieces">Tout afficher</a>
            </div>
            <div class="responsive-table">
                <table class="data-table">
                    <thead><tr><th>Date</th><th>Journal</th><th>Référence</th><th>Libellé</th><th>Statut</th><th class="number">Montant</th></tr></thead>
                    <tbody>
                        @foreach (var entry in _snapshot.RecentEntries)
                        {
                            <tr>
                                <td>@entry.EntryDate.ToString("dd/MM/yyyy")</td>
                                <td><span class="code-badge">@entry.JournalCode</span></td>
                                <td><strong>@entry.Reference</strong></td>
                                <td>@entry.Description</td>
                                <td><span class="status-badge @(entry.Status == "Validée" ? "success" : "draft")">@entry.Status</span></td>
                                <td class="number">@Money(entry.TotalDebit)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <aside class="panel balance-summary">
            <span class="eyebrow">Contrôle</span>
            <h2>Équilibre de la période</h2>
            <div class="balance-total"><span>Mouvements débit</span><strong>@Money(_snapshot.TotalDebitMovements)</strong></div>
            <div class="balance-total"><span>Mouvements crédit</span><strong>@Money(_snapshot.TotalCreditMovements)</strong></div>
            <div class="balance-proof"><span>Écart</span><strong>@Money(_snapshot.TotalDebitMovements - _snapshot.TotalCreditMovements)</strong></div>
            <a class="button button-secondary full-width" href="/comptabilite/balance">Ouvrir la balance</a>
        </aside>
    </div>
}

@code {
    private AccountingSnapshot? _snapshot;

    protected override async Task OnInitializedAsync() =>
        _snapshot = await AccountingService.GetSnapshotAsync();

    private static string Money(decimal value) => $"{value:N0} XOF";
}
