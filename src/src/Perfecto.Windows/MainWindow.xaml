<Window x:Class="Perfecto.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:shared="clr-namespace:Perfecto.Shared.UI;assembly=Perfecto.Shared.UI"
        Title="PERFECTO Nouvelle Génération"
        Width="1360"
        Height="860"
        MinWidth="1024"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">
    <blazor:BlazorWebView x:Name="BlazorView" HostPage="wwwroot\index.html">
        <blazor:BlazorWebView.RootComponents>
            <blazor:RootComponent Selector="#app" ComponentType="{x:Type shared:Routes}" />
        </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>
</Window>
