@page "/comptabilite/pieces"
@inject IAccountingService AccountingService

<PageTitle>Pièces comptables — PERFECTO</PageTitle>

<section class="module-hero compact-hero">
    <div><span class="eyebrow">Comptabilité générale</span><h1>Pièces comptables</h1><p>Écritures de l’exercice 2026, brouillons et pièces validées.</p></div>
    <div class="accounting-actions"><a class="button button-secondary" href="/comptabilite">Retour</a><a class="button button-primary" href="/comptabilite/pieces/nouvelle">Nouvelle pièce</a></div>
</section>

<section class="panel data-panel">
    <div class="table-toolbar">
        <div class="filter-tabs">
            <button class="@AllTabClass" @onclick="FilterAll">Toutes</button>
            <button class="@PostedTabClass" @onclick="FilterPosted">Validées</button>
            <button class="@DraftTabClass" @onclick="FilterDrafts">Brouillons</button>
        </div>
        <span class="result-count">@FilteredEntries.Count pièce(s)</span>
    </div>
    <div class="responsive-table">
        <table class="data-table selectable-table">
            <thead><tr><th>Date</th><th>Journal</th><th>Référence</th><th>Libellé</th><th>Statut</th><th class="number">Débit</th><th class="number">Crédit</th></tr></thead>
            <tbody>
                @foreach (var entry in FilteredEntries)
                {
                    <tr @onclick="() => _selected = entry" class="@(_selected?.Id == entry.Id ? "selected" : string.Empty)">
                        <td>@entry.EntryDate.ToString("dd/MM/yyyy")</td>
                        <td><span class="code-badge">@entry.JournalCode</span></td>
                        <td><strong>@entry.Reference</strong></td>
                        <td>@entry.Description</td>
                        <td><span class="status-badge @(entry.Status == "Validée" ? "success" : "draft")">@entry.Status</span></td>
                        <td class="number">@Money(entry.TotalDebit)</td>
                        <td class="number">@Money(entry.TotalCredit)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@if (_selected is not null)
{
    <section class="panel entry-detail">
        <div class="panel-heading">
            <div><span class="eyebrow">Détail de la pièce</span><h2>@_selected.Reference · @_selected.Description</h2></div>
            <div class="accounting-actions">
                <span class="status-badge @(_selected.Status == "Validée" ? "success" : "draft")">@_selected.Status</span>
                @if (_selected.Status == "Brouillon") { <button class="button button-primary" type="button" @onclick="PostSelectedAsync">Valider la pièce</button> }
            </div>
        </div>
        <div class="responsive-table">
            <table class="data-table"><thead><tr><th>Compte</th><th>Intitulé</th><th>Libellé</th><th class="number">Débit</th><th class="number">Crédit</th></tr></thead>
                <tbody>@foreach (var line in _selected.Lines) { <tr><td><strong>@line.AccountCode</strong></td><td>@line.AccountLabel</td><td>@line.Label</td><td class="number">@Money(line.Debit)</td><td class="number">@Money(line.Credit)</td></tr> }</tbody>
                <tfoot><tr><th colspan="3">Totaux</th><th class="number">@Money(_selected.TotalDebit)</th><th class="number">@Money(_selected.TotalCredit)</th></tr></tfoot>
            </table>
        </div>
    </section>
}

@code {
    private IReadOnlyList<AccountingEntryDto> _entries = [];
    private AccountingEntryDto? _selected;
    private string _filter = "Toutes";
    private IReadOnlyList<AccountingEntryDto> FilteredEntries => _entries.Where(entry => _filter == "Toutes" || entry.Status == _filter).ToList();
    private string AllTabClass => TabClass("Toutes");
    private string PostedTabClass => TabClass("Validée");
    private string DraftTabClass => TabClass("Brouillon");
    protected override async Task OnInitializedAsync() { _entries = await AccountingService.GetEntriesAsync(); _selected = _entries.FirstOrDefault(); }
    private string TabClass(string value) => _filter == value ? "active" : string.Empty;
    private void FilterAll() => _filter = "Toutes";
    private void FilterPosted() => _filter = "Validée";
    private void FilterDrafts() => _filter = "Brouillon";
    private async Task PostSelectedAsync() { if (_selected is null) return; var posted = await AccountingService.PostEntryAsync(_selected.Id); _entries = _entries.Select(entry => entry.Id == posted.Id ? posted : entry).ToList(); _selected = posted; }
    private static string Money(decimal value) => value == 0 ? "—" : $"{value:N0}";
}
