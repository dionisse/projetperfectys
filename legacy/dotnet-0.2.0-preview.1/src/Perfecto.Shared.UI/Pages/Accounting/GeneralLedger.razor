@page "/comptabilite/etats/grand-livre"
@inject IAccountingService AccountingService

<PageTitle>Grand livre — PERFECTO</PageTitle>

<section class="module-hero compact-hero">
    <div><span class="eyebrow">États comptables</span><h1>Grand livre général</h1><p>Mouvements validés et solde progressif compte par compte.</p></div>
    <a class="button button-secondary" href="/comptabilite">Retour au module</a>
</section>

@if (_accounts.Count > 0)
{
    <section class="panel data-panel">
        <div class="table-toolbar">
            <label class="inline-filter wide"><span>Compte</span><select @bind="_selectedCode">@foreach (var account in _accounts) { <option value="@account.AccountCode">@account.AccountCode · @account.AccountLabel</option> }</select></label>
            @if (SelectedAccount is not null) { <span class="balance-pill">Solde : @SignedMoney(SelectedAccount.ClosingBalance)</span> }
        </div>
        @if (SelectedAccount is not null)
        {
            <div class="ledger-heading"><strong>@SelectedAccount.AccountCode · @SelectedAccount.AccountLabel</strong><span>Débit @Money(SelectedAccount.TotalDebit) · Crédit @Money(SelectedAccount.TotalCredit)</span></div>
            <div class="responsive-table">
                <table class="data-table"><thead><tr><th>Date</th><th>Journal</th><th>Pièce</th><th>Libellé</th><th class="number">Débit</th><th class="number">Crédit</th><th class="number">Solde cumulé</th></tr></thead>
                    <tbody>@foreach (var line in SelectedAccount.Lines) { <tr><td>@line.EntryDate.ToString("dd/MM/yyyy")</td><td><span class="code-badge">@line.JournalCode</span></td><td>@line.Reference</td><td>@line.Label</td><td class="number">@Money(line.Debit)</td><td class="number">@Money(line.Credit)</td><td class="number"><strong>@SignedMoney(line.RunningBalance)</strong></td></tr> }</tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    private IReadOnlyList<LedgerAccountDto> _accounts = [];
    private string _selectedCode = string.Empty;
    private LedgerAccountDto? SelectedAccount => _accounts.FirstOrDefault(account => account.AccountCode == _selectedCode);
    protected override async Task OnInitializedAsync() { _accounts = await AccountingService.GetGeneralLedgerAsync(); _selectedCode = _accounts.FirstOrDefault()?.AccountCode ?? string.Empty; }
    private static string Money(decimal value) => value == 0 ? "—" : $"{value:N0}";
    private static string SignedMoney(decimal value) => value == 0 ? "0" : value > 0 ? $"{value:N0} D" : $"{-value:N0} C";
}
