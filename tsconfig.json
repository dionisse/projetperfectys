{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@perfecto/domain": ["packages/domain/src/index.ts"],
      "@perfecto/contracts": ["packages/contracts/src/index.ts"],
      "@perfecto/application": ["packages/application/src/index.ts"],
      "@perfecto/exports": ["packages/exports/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*", "packages/*/test/**/*", "vitest.config.ts"]
}
